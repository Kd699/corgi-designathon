# Model upstream for the dayboard. Copy to .env.local (gitignored). Read by the dev server
# only — vite.config.ts proxies /api/xai and adds the auth server-side, so nothing here ever
# reaches the browser bundle.
#
# Preferred: Spacetime's llm-proxy edge function. The xAI key stays in Supabase's secrets;
# this machine only needs the project URL and its anon token.
LLM_PROXY_URL=https://<project>.supabase.co/functions/v1/llm-proxy
LLM_PROXY_TOKEN=

# Or go direct, if you have your own xAI key and no Supabase access.
XAI_API_KEY=

# With neither set the dayboard still runs on its local read; the status line says which.
